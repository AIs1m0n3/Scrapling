# ── OpenRouter LLM ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modello principale (qualità) — per pianificazione siti e riassunti
OPENROUTER_MODEL=anthropic/claude-opus-4

# Modello economico — per analisi HTML e generazione selettori CSS
# google/gemini-flash-1.5: ~$0.075/$0.30 per M token, finestra 1M token
OPENROUTER_SEARCH_MODEL=google/gemini-flash-1.5

# Modello embeddings — per ricerca semantica sui dati estratti
OPENROUTER_EMBED_MODEL=perplexity/pplx-embed-v1-4b

# ── SSL ───────────────────────────────────────────────────────────────────────
# Percorso al CA bundle (lascia vuoto per auto-rilevamento dal repo root)
CACERT_PATH=./cacert.pem

# ── Timeout ───────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30          # secondi (Fetcher curl_cffi)
BROWSER_TIMEOUT=30000    # millisecondi (StealthyFetcher Playwright)

# ── Retries ───────────────────────────────────────────────────────────────────
HTTP_RETRIES=3
HTTP_RETRY_DELAY=2

# ── Pipeline smart-scrape ─────────────────────────────────────────────────────
SMART_SCRAPE_MAX_SITES=5
MAX_ROWS_PER_SELECTOR=20
HTML_SNIPPET_MAX_CHARS=12000   # max chars HTML inviati all'LLM per analisi

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=./data   # directory per il SQLite embedding store
